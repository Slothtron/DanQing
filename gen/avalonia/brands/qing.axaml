<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 丹青 · 品牌 overlay「群青 Qún Qīng」（生成物，勿手改） -->
  <!-- 沉静理性，蓝为通用商务与工具类首选，久看不躁 -->
  <!-- 适用：工具、效率、金融、企业后台 -->
  <!-- 须与 Tokens.axaml 基座一起合并，且一次只合并一支 -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="DqTextLink" Color="#2E59A7" />
      <SolidColorBrush x:Key="DqPrimaryDefault" Color="#2E59A7" />
      <SolidColorBrush x:Key="DqPrimaryHover" Color="#1A4188" />
      <SolidColorBrush x:Key="DqPrimaryActive" Color="#092964" />
      <SolidColorBrush x:Key="DqPrimarySubtle" Color="#D1E2FF" />
      <SolidColorBrush x:Key="DqPrimaryBorder" Color="#2E59A7" />
      <SolidColorBrush x:Key="DqPrimaryText" Color="#2E59A7" />
      <SolidColorBrush x:Key="DqPrimaryOn" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DqFocusRing" Color="#2E59A7" />
      <!-- FluentTheme 兼容：原生控件（ToggleSwitch / ComboBox / 焦点环等）跟随品牌 -->
      <!-- Fluent 要的是「1 基色 + Light1..3 + Dark1..3」的渐层，丹青给的是语义 7 角色，形状不同；此处按混合比例派生近似值 -->
      <Color x:Key="SystemAccentColor">#2E59A7</Color>
      <Color x:Key="SystemAccentColorLight1">#4D72B4</Color>
      <Color x:Key="SystemAccentColorLight2">#6D8BC1</Color>
      <Color x:Key="SystemAccentColorLight3">#8CA4CF</Color>
      <Color x:Key="SystemAccentColorDark1">#274C8E</Color>
      <Color x:Key="SystemAccentColorDark2">#203E75</Color>
      <Color x:Key="SystemAccentColorDark3">#19315C</Color>
      <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2E59A7" />
      <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#DD2E59A7" />
      <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#802E59A7" />
      <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#D1E2FF" />
      <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#2E59A7" />
      <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#2E59A7" />
      <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#6282BD" />
      <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
      <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#66FFFFFF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="DqTextLink" Color="#759BDC" />
      <SolidColorBrush x:Key="DqPrimaryDefault" Color="#416CBA" />
      <SolidColorBrush x:Key="DqPrimaryHover" Color="#5A83CC" />
      <SolidColorBrush x:Key="DqPrimaryActive" Color="#759BDC" />
      <SolidColorBrush x:Key="DqPrimarySubtle" Color="#092964" />
      <SolidColorBrush x:Key="DqPrimaryBorder" Color="#416CBA" />
      <SolidColorBrush x:Key="DqPrimaryText" Color="#759BDC" />
      <SolidColorBrush x:Key="DqPrimaryOn" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DqFocusRing" Color="#416CBA" />
      <!-- FluentTheme 兼容：原生控件（ToggleSwitch / ComboBox / 焦点环等）跟随品牌 -->
      <!-- Fluent 要的是「1 基色 + Light1..3 + Dark1..3」的渐层，丹青给的是语义 7 角色，形状不同；此处按混合比例派生近似值 -->
      <Color x:Key="SystemAccentColor">#416CBA</Color>
      <Color x:Key="SystemAccentColorLight1">#5E82C4</Color>
      <Color x:Key="SystemAccentColorLight2">#7A98CF</Color>
      <Color x:Key="SystemAccentColorLight3">#96AED9</Color>
      <Color x:Key="SystemAccentColorDark1">#375C9E</Color>
      <Color x:Key="SystemAccentColorDark2">#2D4C82</Color>
      <Color x:Key="SystemAccentColorDark3">#243B66</Color>
      <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#416CBA" />
      <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#DD416CBA" />
      <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#80416CBA" />
      <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#092964" />
      <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#759BDC" />
      <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#759BDC" />
      <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#7091CB" />
      <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
      <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#66FFFFFF" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
