<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 丹青 · 品牌 overlay「檀色 Tán Sè」（生成物，勿手改） -->
  <!-- 温厚赭褐，纸墨之外的旧物感，在地性强 -->
  <!-- 适用：文创、出版、手作、在地生活 -->
  <!-- 须与 Tokens.axaml 基座一起合并，且一次只合并一支 -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="DqTextLink" Color="#82473A" />
      <SolidColorBrush x:Key="DqPrimaryDefault" Color="#B26D5D" />
      <SolidColorBrush x:Key="DqPrimaryHover" Color="#9C5A4B" />
      <SolidColorBrush x:Key="DqPrimaryActive" Color="#82473A" />
      <SolidColorBrush x:Key="DqPrimarySubtle" Color="#F9D9D1" />
      <SolidColorBrush x:Key="DqPrimaryBorder" Color="#B26D5D" />
      <SolidColorBrush x:Key="DqPrimaryText" Color="#82473A" />
      <SolidColorBrush x:Key="DqPrimaryOn" Color="#0E1116" />
      <SolidColorBrush x:Key="DqFocusRing" Color="#B26D5D" />
      <!-- FluentTheme 兼容：原生控件（ToggleSwitch / ComboBox / 焦点环等）跟随品牌 -->
      <!-- Fluent 要的是「1 基色 + Light1..3 + Dark1..3」的渐层，丹青给的是语义 7 角色，形状不同；此处按混合比例派生近似值 -->
      <Color x:Key="SystemAccentColor">#B26D5D</Color>
      <Color x:Key="SystemAccentColorLight1">#BE8375</Color>
      <Color x:Key="SystemAccentColorLight2">#C9998E</Color>
      <Color x:Key="SystemAccentColorLight3">#D5AFA6</Color>
      <Color x:Key="SystemAccentColorDark1">#975D4F</Color>
      <Color x:Key="SystemAccentColorDark2">#7D4C41</Color>
      <Color x:Key="SystemAccentColorDark3">#623C33</Color>
      <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#B26D5D" />
      <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#DDB26D5D" />
      <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#80B26D5D" />
      <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#F9D9D1" />
      <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#82473A" />
      <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#82473A" />
      <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#C59285" />
      <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0E1116" />
      <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E60E1116" />
      <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#660E1116" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="DqTextLink" Color="#CA8778" />
      <SolidColorBrush x:Key="DqPrimaryDefault" Color="#B26D5D" />
      <SolidColorBrush x:Key="DqPrimaryHover" Color="#CA8778" />
      <SolidColorBrush x:Key="DqPrimaryActive" Color="#DCA193" />
      <SolidColorBrush x:Key="DqPrimarySubtle" Color="#492017" />
      <SolidColorBrush x:Key="DqPrimaryBorder" Color="#B26D5D" />
      <SolidColorBrush x:Key="DqPrimaryText" Color="#CA8778" />
      <SolidColorBrush x:Key="DqPrimaryOn" Color="#0E1116" />
      <SolidColorBrush x:Key="DqFocusRing" Color="#B26D5D" />
      <!-- FluentTheme 兼容：原生控件（ToggleSwitch / ComboBox / 焦点环等）跟随品牌 -->
      <!-- Fluent 要的是「1 基色 + Light1..3 + Dark1..3」的渐层，丹青给的是语义 7 角色，形状不同；此处按混合比例派生近似值 -->
      <Color x:Key="SystemAccentColor">#B26D5D</Color>
      <Color x:Key="SystemAccentColorLight1">#BE8375</Color>
      <Color x:Key="SystemAccentColorLight2">#C9998E</Color>
      <Color x:Key="SystemAccentColorLight3">#D5AFA6</Color>
      <Color x:Key="SystemAccentColorDark1">#975D4F</Color>
      <Color x:Key="SystemAccentColorDark2">#7D4C41</Color>
      <Color x:Key="SystemAccentColorDark3">#623C33</Color>
      <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#B26D5D" />
      <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#DDB26D5D" />
      <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#80B26D5D" />
      <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#492017" />
      <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#CA8778" />
      <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#CA8778" />
      <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#C59285" />
      <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0E1116" />
      <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E60E1116" />
      <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#660E1116" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
